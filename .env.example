# ---------------------------------------------------------------------------
# apps/web (Next.js) — variables serveur uniquement, jamais exposées au client
# ---------------------------------------------------------------------------

# TomTom. Utilisée par /api/route (trafic), /api/safety (incidents),
# /api/speed-limit (snap to roads) et /api/station-details (recherche POI).
# Sans cette clé, ces routes répondent en mode dégradé (connected:false)
# au lieu d'échouer.
TOMTOM_API_KEY=

# Mistral. Utilisée par /api/ai et /api/poi.
# Note : le code accepte encore l'ancien nom `mistralfloway` en repli, le temps
# que la variable soit renommée dans les environnements de déploiement.
MISTRAL_API_KEY=

# Secret partagé facultatif. S'il est défini, un appelant serveur à serveur peut
# accéder à /api/ai en présentant l'en-tête `x-floway-key`. Sans lui, la route
# n'accepte que les requêtes provenant de l'application elle-même.
FLOWAY_API_SECRET=

# ---------------------------------------------------------------------------
# apps/mobile (Expo) — non utilisé par apps/web
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
